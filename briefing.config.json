{
  "config_version": 1,
  "repository": "fayazamir1991/news",
  "default_branch": "main",
  "site_url": "https://visionwatcher.vercel.app",
  "language": "fa",
  "timezone": "Asia/Tehran",
  "schedule": {
    "local_time": "00:05",
    "target_day": "previous_calendar_day_of_original_scheduled_for",
    "runner": "external",
    "create_duplicate_scheduler": false
  },
  "display_dates": {
    "calendar": "persian",
    "digits": "persian",
    "month": "persian_name"
  },
  "file_dates": {
    "calendar": "persian",
    "digits": "latin",
    "format": "YYYY-MM-DD"
  },
  "sections": [
    {
      "title": "مقالهٔ مروری روز",
      "maximum": 1
    },
    {
      "title": "پژوهش‌ها",
      "maximum": 10
    },
    {
      "title": "بینایی ماشین",
      "maximum": 5
    },
    {
      "title": "هوش مصنوعی",
      "maximum": 5
    },
    {
      "title": "گیت‌هاب",
      "maximum": 5
    }
  ],
  "github_discovery": {
    "routine_commits_qualify": false,
    "total_stars_prove_trending": false,
    "repeat_without_substantive_new_event": false,
    "sources_file": "GITHUB_DISCOVERY_SOURCES.md",
    "sources": [
      {
        "id": "github_trending",
        "url": "https://github.com/trending",
        "priority": "primary",
        "role": "github_ranking"
      },
      {
        "id": "trendshift",
        "url": "https://trendshift.io/",
        "priority": "primary",
        "role": "third_party_ranking"
      },
      {
        "id": "trendshift_image_recognition",
        "url": "https://trendshift.io/topics/image-recognition",
        "priority": "primary",
        "role": "topic_discovery"
      },
      {
        "id": "upstar_computer_vision",
        "url": "https://upstar.dev/t/computer-vision",
        "priority": "supplementary",
        "role": "third_party_ranking"
      },
      {
        "id": "star_history",
        "url": "https://www.star-history.com/",
        "priority": "supplementary",
        "role": "growth_verification"
      },
      {
        "id": "trendrepo",
        "url": "https://trendrepo.dev/",
        "priority": "supplementary",
        "role": "third_party_growth_discovery"
      },
      {
        "id": "hugging_face_papers",
        "url": "https://huggingface.co/papers/trending",
        "priority": "supplementary",
        "role": "research_discovery"
      },
      {
        "id": "github_computer_vision",
        "url": "https://github.com/topics/computer-vision",
        "priority": "supplementary",
        "role": "topic_discovery"
      },
      {
        "id": "daily_launch",
        "url": "https://dailylaunch.org/",
        "priority": "supplementary",
        "role": "dated_launch_ranking"
      }
    ],
    "recency_anchor": "content_as_of",
    "new_project_days": 30,
    "preferred_attention_days": 7,
    "explanation_paragraphs": {
      "minimum": 4,
      "maximum": 6
    },
    "explanation_target_words": {
      "minimum": 200,
      "maximum": 350
    },
    "explanation_fields": [
      "what_it_is",
      "inputs_outputs",
      "concrete_use_case",
      "how_it_works",
      "technical_value",
      "dated_attention_evidence",
      "available_artifacts",
      "licenses",
      "practical_limits"
    ]
  },
  "publishing": {
    "directory": "content/briefings",
    "branch_prefix": "daily/",
    "use_pull_request": true,
    "merge_after_exact_head_ci_success": true,
    "ci_workflow_name": "Build and smoke-test website",
    "overwrite_published_issue": false,
    "owner_authorization_required": true
  },
  "delivery": {
    "channel": "authorized_runner_output",
    "same_report_as_repository": true
  },
  "canonical_prompt": "DAILY_BRIEFING_PROMPT.md",
  "configuration_is_executed_by_runner_not_site_builder": true,
  "content_recency": {
    "selection": "freshness_and_relevance_over_exact_issue_day",
    "preferred_days": 7,
    "maximum_days": 30,
    "anchor": "content_as_of_first_actual_execution",
    "pin_anchor_on_retry": true,
    "backfill": "disclose_gathering_date_and_allow_current_recent_work_unless_explicit_historical_reconstruction",
    "exact_publication_day_required": false,
    "source_dates_must_be_truthful": true
  },
  "execution_metadata": {
    "file_suffix": ".execution.json",
    "schema_version": 1,
    "unknown_behavior": "omit",
    "estimate_usage": false,
    "model_provenance": [
      "provider_response",
      "runner_metadata"
    ],
    "usage_provenance": [
      "provider_usage",
      "runner_usage"
    ],
    "coverage": [
      "full_run",
      "partial_run"
    ],
    "count_distinct_model_calls_and_retries": true,
    "never_double_count_reasoning_or_cached_subtotals": true
  },
  "daily_survey": {
    "source": "arxiv",
    "position": "first",
    "target_count": 1,
    "read_entire_paper": true,
    "educational_recency_exception": true,
    "avoid_repeating_arxiv_id": true,
    "subsections": [
      "توضیح و تحلیل مقاله",
      "ترجمهٔ کامل مقدمه",
      "ترجمهٔ کامل نتیجه‌گیری"
    ],
    "analysis_target_words": {
      "minimum": 800,
      "maximum": 1200
    },
    "translate_entire_introduction_and_conclusion": true,
    "verify_public_translation_license": true,
    "attribution_and_version_required": true,
    "not_part_of_ten_new_research_items": true,
    "missing_or_unreadable_policy": "choose_another_eligible_survey_or_explain_in_lead_without_fabrication",
    "directory": "content/surveys",
    "archive_route": "/surveys/",
    "article_route": "/surveys/<arxiv_id>/",
    "daily_teaser_paragraphs": 1,
    "full_content_on_dedicated_page": true,
    "same_bookmark_id_on_teaser_and_article": true,
    "metadata_fields": [
      "arxiv_id",
      "first_issue",
      "summary",
      "paper_date",
      "paper_date_kind",
      "paper_date_source"
    ],
    "subsection_heading_level": 2,
    "paper_date_kinds": [
      "submitted",
      "published"
    ],
    "paper_date_primary_evidence_required": true,
    "paper_date_on_daily_card_and_article": true,
    "direct_sources_position": "separate_panel_next_to_table_of_contents_before_full_text"
  },
  "navigation": {
    "account_route": "/account/",
    "mobile_order": "right_to_left",
    "mobile_items": [
      {
        "label": "آرشیو",
        "href": "/archive/"
      },
      {
        "label": "مروری‌ها",
        "href": "/surveys/"
      },
      {
        "label": "خانه",
        "href": "/"
      },
      {
        "label": "حساب",
        "href": "/account/"
      },
      {
        "label": "ذخیره‌ها",
        "href": "/bookmarks/"
      }
    ],
    "desktop_surveys_link": true
  }
}
